---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Moderasi" description="Antrian verifikasi Pelayan Rakyat." noindex>
  <section class="hero">
    <p class="eyebrow">Moderasi</p>
    <h1>Antrian verifikasi</h1>
    <p class="lede">
      Halaman ini hanya untuk moderator. Tidak ada tautan publik ke sini.
    </p>
  </section>

  <div id="moderasi-root" data-page="queue"></div>

  <section class="hero">
    <h2>Antrian crowdsourcing</h2>
    <p><a class="button" href="/moderasi/kiriman">Kiriman kontributor</a> <a class="button button--quiet" href="/moderasi/laporan">Laporan masalah</a></p>
  </section>

  <script is:inline src="/scripts/moderasi.js" defer></script>
</BaseLayout>
