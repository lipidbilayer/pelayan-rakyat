---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cari"
  description="Cari catatan publik di Pelayan Rakyat."
  noindex
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </Fragment>

  <section class="hero">
    <p class="eyebrow">Cari</p>
    <h1>Cari catatan publik</h1>
    <p class="lede">
      Pencarian berjalan sepenuhnya di peramban Anda. Tidak ada kata kunci yang
      dikirim ke server.
    </p>
  </section>

  <div class="search-panel" id="cari"></div>

  <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
  <script is:inline src="/scripts/search.js" defer></script>
</BaseLayout>
