      Pelayan Rakyat membantu pemilih mengingat rekam jejak publik orang yang
      mereka gaji. Situs ini independen dan bukan situs pemerintah.
    </p>
  </section>
  <section aria-labelledby="siapa">
    <h2 id="siapa">Siapa yang menjalankan</h2>
    <p>[ISI OLEH PEMILIK]</p>
  </section>
  <section aria-labelledby="dana">
    <h2 id="dana">Pendanaan</h2>
    <p>[ISI OLEH PEMILIK]</p>
  </section>
  <section aria-labelledby="kontak">
    <h2 id="kontak">Kontak</h2>
    <p>[ISI OLEH PEMILIK]</p>
  </section>
</BaseLayout>
