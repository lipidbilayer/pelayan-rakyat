                <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;font-size:13px;color:var(--meta)">
                  <span style="font-weight:500;color:var(--body);border:1px solid var(--line);border-radius:6px;padding:2px 8px">{person?.full_name || "Pejabat"}</span>
                  <span aria-hidden="true">•</span>
                  <span>{formatDate(record.occurred_at, record.occurred_at_precision)}</span>
                  {record.blunder_category && <span style="margin-left:auto;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;background:var(--rose-bg);color:var(--rose-fg);border:1px solid var(--rose-line)">Inkonsistensi</span>}
                </div>
                <h3 style="margin:0;font-size:16px;font-weight:600;color:var(--title)">{record.title}</h3>
                <p style="margin:0;max-width:720px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{record.summary || record.context}</p>
                <a href={`/catatan/${record.slug}`} style="align-self:flex-start;display:inline-flex;align-items:center;gap:6px;padding:6px 10px;margin-top:2px;border-radius:6px;background:var(--chip);border:1px solid var(--line);font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--body)">
                  <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
                  Lihat catatan
                </a>
              </article>
            );
          })}
          {snapshot.recentRecords.length === 0 && <p style="margin:0;padding:28px 20px;border:1px dashed var(--line-strong);border-radius:12px;text-align:center;color:var(--meta)">Belum ada pernyataan terverifikasi minggu ini.</p>}
        </div>
      </section>
    </main>

    <footer style="border-top:1px solid var(--line)">
      <div style="max-width:1120px;margin:0 auto;padding:24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;font-size:13px;color:var(--meta)">
        <span>Independen — bukan situs pemerintah. {updated}</span>
        <div style="display:flex;gap:20px"><a href="/metode">Metode</a><a href="/tentang">Tentang</a><a href="/koreksi">Koreksi</a></div>
      </div>
    </footer>
  </div>
</HomeLayout>
