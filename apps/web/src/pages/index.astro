<HomeLayout title="Pelayan Rakyat" description="Catatan publik tentang ucapan, janji, dan kinerja pejabat di Indonesia. Independen, bersumber, dan tanpa glorifikasi.">
  <div class="pr" style="--bg:#fcfcfd;--card:#ffffff;--line:#e2e8f0;--line-strong:#cbd5e1;--title:#0f172a;--body:#475569;--meta:#64748b;--chip:#f8fafc;--ink:#0f172a;--ink-on:#ffffff;--track:#eef2f6;--amber-bg:#fffbeb;--amber-fg:#92400e;--amber-line:#fde68a;--rose-bg:#f5f3ff;--rose-fg:#5b21b6;--rose-line:#ddd6fe;--accent:#c8102e;--accent-on:#ffffff;--accent-text:#b91c1c;--neutral-bg:#f1f5f9;--neutral-fg:#334155;--against:#c2410c;--support:#1d4ed8;--sea:#f1f5f9;--land:#cbd5e1;--hero:#c8102e;--motif:rgba(255,255,255,0.17);min-height:100vh;background:var(--bg);color:var(--body);font-family:Geist,Inter,system-ui,sans-serif;font-size:15px;line-height:1.5;overflow-x:hidden">

    <div style="min-height:min(100vh,860px);display:flex;flex-direction:column">
      <div class="pr-hero" style="flex:3 1 auto;display:flex;flex-direction:column;color:#ffffff;background-color:var(--hero);background-image:radial-gradient(ellipse 46% 52% at 50% 58%,var(--hero) 0,var(--hero) 55%,transparent 100%),radial-gradient(circle at 0 0,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 100% 0,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 0 100%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 100% 100%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 50% 50%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 50% 50%,var(--motif) 0,var(--motif) 3px,transparent 3px);background-size:100% 100%,48px 48px,48px 48px,48px 48px,48px 48px,48px 48px,48px 48px">
        <header>
          <div style="max-width:1120px;margin:0 auto;padding:14px 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px">
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px">
              <a href="/" style="font-weight:700;font-size:15px;letter-spacing:0.08em;color:#ffffff;display:inline-flex;align-items:center;gap:10px">
                <span aria-hidden="true" style="display:flex;flex-direction:column;width:20px;height:14px;border:1px solid rgba(255,255,255,0.8);border-radius:3px;overflow:hidden;box-sizing:border-box"><span style="flex:1;background:var(--accent)"></span><span style="flex:1;background:#ffffff"></span></span>
                PELAYAN RAKYAT
              </a>
              <span style="font-size:11px;font-weight:500;color:#ffffff;border:1px solid rgba(255,255,255,0.55);border-radius:999px;padding:3px 10px">Independen — Bukan Situs Pemerintah</span>
            </div>
            <nav style="display:flex;align-items:center;gap:8px">
              <div class="pr-navlinks" style="display:flex;align-items:center;gap:4px;font-size:14px;font-weight:500">
                <a href="#peta" style="padding:12px 12px">Peta</a>
                <a href="#isu" style="padding:12px 12px">Isu Hangat</a>
                <a href="#janji" style="padding:12px 12px">Janji</a>
                <a href="#kirim" style="padding:12px 12px">Kirim Laporan</a>
              </div>
              <a class="pr-cta" href="/kirim" style="display:inline-flex;align-items:center;gap:6px;min-height:44px;box-sizing:border-box;padding:0 16px;border:1px solid #ffffff;background:#ffffff;border-radius:10px;font-size:14px;font-weight:600;color:var(--hero)">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                Laporkan Jejak
              </a>
            </nav>
          </div>
        </header>
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:20px;padding:40px 24px 96px">
          <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.14em;color:rgba(255,255,255,0.9)">PLATFORM AKUNTABILITAS PUBLIK</p>
          <h1 style="margin:0;max-width:920px;font-size:clamp(36px,5.6vw,64px);line-height:1.05;font-weight:700;letter-spacing:-0.03em;color:#ffffff;text-wrap:balance">Pantau Janji dan Rekam Jejak Pejabat Publik.</h1>
          <p style="margin:0;max-width:600px;font-size:19px;color:rgba(255,255,255,0.94)">Basis data independen berbasis bukti primer. Kita gaji, kita nilai.</p>
        </div>
      </div>

      <section style="flex:2 1 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px;padding:0 24px 24px">
        <form role="search" action="/cari" method="get" style="width:100%;max-width:760px;margin-top:-36px;display:flex;align-items:center;gap:12px;box-sizing:border-box;padding:0 12px 0 22px;height:72px;background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 10px 30px rgba(15,23,42,0.12)">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex:none;color:var(--meta)"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <label for="cari" class="pr-sr">Cari pejabat, kebijakan, atau isu</label>
          <input id="cari" name="q" type="search" placeholder="Cari nama pejabat, kebijakan, atau isu hangat..." style="flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;font:inherit;font-size:16px;color:var(--title)">
          <kbd class="pr-kbd" style="flex:none;font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--meta);border:1px solid var(--line);border-radius:6px;padding:2px 7px;background:var(--chip)">⌘K</kbd>
          <button type="submit" style="flex:none;height:48px;padding:0 22px;border:0;border-radius:12px;background:var(--accent);color:var(--accent-on);font:inherit;font-size:15px;font-weight:600;cursor:pointer">Cari</button>
        </form>

        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;font-size:13px">
          <span style="color:var(--meta);margin-right:4px">Isu Populer:</span>
