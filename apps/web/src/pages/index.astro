<HomeLayout title="Pelayan Rakyat" description="Catatan publik tentang ucapan, janji, dan kinerja pejabat di Indonesia. Independen, bersumber, dan tanpa glorifikasi.">
  <div class="pr" style="--bg:#fcfcfd;--card:#ffffff;--line:#e2e8f0;--line-strong:#cbd5e1;--title:#0f172a;--body:#475569;--meta:#64748b;--chip:#f8fafc;--ink:#0f172a;--ink-on:#ffffff;--track:#eef2f6;--amber-bg:#fffbeb;--amber-fg:#92400e;--amber-line:#fde68a;--rose-bg:#f5f3ff;--rose-fg:#5b21b6;--rose-line:#ddd6fe;--accent:#c8102e;--accent-on:#ffffff;--accent-text:#b91c1c;--neutral-bg:#f1f5f9;--neutral-fg:#334155;--against:#c2410c;--support:#1d4ed8;--sea:#f1f5f9;--land:#cbd5e1;--hero:#c8102e;--motif:rgba(255,255,255,0.17);min-height:100vh;background:var(--bg);color:var(--body);font-family:Geist,Inter,system-ui,sans-serif;font-size:15px;line-height:1.5;overflow-x:hidden">

    <div style="min-height:min(100vh,860px);display:flex;flex-direction:column">
      <div class="pr-hero" style="flex:3 1 auto;display:flex;flex-direction:column;color:#ffffff;background-color:var(--hero);background-image:radial-gradient(ellipse 46% 52% at 50% 58%,var(--hero) 0,var(--hero) 55%,transparent 100%),radial-gradient(circle at 0 0,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 100% 0,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 0 100%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 100% 100%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 50% 50%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 50% 50%,var(--motif) 0,var(--motif) 3px,transparent 3px);background-size:100% 100%,48px 48px,48px 48px,48px 48px,48px 48px,48px 48px,48px 48px">
        <header>
          <div style="max-width:1120px;margin:0 auto;padding:14px 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px">
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px">
              <a href="/" style="font-weight:700;font-size:15px;letter-spacing:0.08em;color:#ffffff;display:inline-flex;align-items:center;gap:10px">
                <span aria-hidden="true" style="display:flex;flex-direction:column;width:20px;height:14px;border:1px solid rgba(255,255,255,0.8);border-radius:3px;overflow:hidden;box-sizing:border-box"><span style="flex:1;background:var(--accent)"></span><span style="flex:1;background:#ffffff"></span></span>
                PELAYAN RAKYAT
              </a>
              <span style="font-size:11px;font-weight:500;color:#ffffff;border:1px solid rgba(255,255,255,0.55);border-radius:999px;padding:3px 10px">Independen — Bukan Situs Pemerintah</span>
            </div>
            <nav style="display:flex;align-items:center;gap:8px">
              <div class="pr-navlinks" style="display:flex;align-items:center;gap:4px;font-size:14px;font-weight:500">
                <a href="#peta" style="padding:12px 12px">Peta</a>
                <a href="#isu" style="padding:12px 12px">Isu Hangat</a>
                <a href="#janji" style="padding:12px 12px">Janji</a>
                <a href="#kirim" style="padding:12px 12px">Kirim Laporan</a>
              </div>
              <a class="pr-cta" href="/kirim" style="display:inline-flex;align-items:center;gap:6px;min-height:44px;box-sizing:border-box;padding:0 16px;border:1px solid #ffffff;background:#ffffff;border-radius:10px;font-size:14px;font-weight:600;color:var(--hero)">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                Laporkan Jejak
              </a>
            </nav>
          </div>
        </header>
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:20px;padding:40px 24px 96px">
          <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.14em;color:rgba(255,255,255,0.9)">PLATFORM AKUNTABILITAS PUBLIK</p>
          <h1 style="margin:0;max-width:920px;font-size:clamp(36px,5.6vw,64px);line-height:1.05;font-weight:700;letter-spacing:-0.03em;color:#ffffff;text-wrap:balance">Pantau Janji dan Rekam Jejak Pejabat Publik.</h1>
          <p style="margin:0;max-width:600px;font-size:19px;color:rgba(255,255,255,0.94)">Basis data independen berbasis bukti primer. Kita gaji, kita nilai.</p>
        </div>
      </div>

      <section style="flex:2 1 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px;padding:0 24px 24px">
        <form role="search" action="/cari" method="get" style="width:100%;max-width:760px;margin-top:-36px;display:flex;align-items:center;gap:12px;box-sizing:border-box;padding:0 12px 0 22px;height:72px;background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 10px 30px rgba(15,23,42,0.12)">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex:none;color:var(--meta)"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <label for="cari" class="pr-sr">Cari pejabat, kebijakan, atau isu</label>
          <input id="cari" name="q" type="search" placeholder="Cari nama pejabat, kebijakan, atau isu hangat..." style="flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;font:inherit;font-size:16px;color:var(--title)">
          <kbd class="pr-kbd" style="flex:none;font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--meta);border:1px solid var(--line);border-radius:6px;padding:2px 7px;background:var(--chip)">⌘K</kbd>
          <button type="submit" style="flex:none;height:48px;padding:0 22px;border:0;border-radius:12px;background:var(--accent);color:var(--accent-on);font:inherit;font-size:15px;font-weight:600;cursor:pointer">Cari</button>
        </form>

        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;font-size:13px">
          <span style="color:var(--meta);margin-right:4px">Isu Populer:</span>
          <a href="/cari?q=Kenaikan+Tarif+Air" style="padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500">#KenaikanTarifAir</a>
          <a href="/cari?q=Banjir+DKI" style="padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500">#BanjirDKI</a>
          <a href="/cari?q=Janji+Transportasi" style="padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500">#JanjiTransportasi</a>
          <a href="/cari?q=DPRD+DKI" style="padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500">#DPRDDKI</a>
        </div>
        <a href="#peta" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;min-height:44px;font-size:13px;font-weight:500;color:var(--meta)">Atau pilih wilayah di peta
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
        </a>
      </section>
    </div>

    <main style="max-width:1120px;margin:0 auto;padding:48px 24px 80px;display:flex;flex-direction:column;gap:72px">
      <section id="peta" style="display:flex;flex-direction:column;gap:20px">
        <div style="display:flex;flex-direction:column;gap:8px">
          <h2 style="margin:0;font-size:clamp(26px,3.2vw,36px);line-height:1.1;font-weight:700;letter-spacing:-0.03em;color:var(--title)">Siapa yang melayani wilayah Anda?</h2>
          <p style="margin:0;max-width:620px;font-size:17px;color:var(--meta)">Pilih pulau, lalu provinsi, lalu kota. Daftar pejabat wilayah itu muncul di samping peta.</p>
        </div>

        <div class="pr-map-shell">
          <input class="pr-map-state" type="radio" name="pr-map" id="st-nasional" checked />
          <input class="pr-map-state" type="radio" name="pr-map" id="st-pulau" />
          <input class="pr-map-state" type="radio" name="pr-map" id="st-provinsi" />
          <input class="pr-map-state" type="radio" name="pr-map" id="st-provinsi-banten" />
          <input class="pr-map-state" type="radio" name="pr-map" id="st-kota-banten" />
          <input class="pr-map-state" type="radio" name="pr-map" id="st-provinsi-jawabarat" />
          <input class="pr-map-state" type="radio" name="pr-map" id="st-kota-jawabarat" />
          {cityRegions.map((city) => (
            <input class="pr-map-state" type="radio" name="pr-map" id={`st-kota-${city.slug}`} />
          ))}
          <nav class="crumbs crumbs-nasional" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb on" tabindex="0" for="st-nasional">Indonesia</label>
          </nav>
          <nav class="crumbs crumbs-pulau" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb on" tabindex="0" for="st-pulau">Jawa</label>
          </nav>
          <nav class="crumbs crumbs-provinsi" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-pulau">Jawa</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb on" tabindex="0" for="st-provinsi">DKI Jakarta</label>
          </nav>
          <nav class="crumbs crumbs-provinsi-banten" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-pulau">Jawa</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb on" tabindex="0" for="st-provinsi-banten">Banten</label>
          </nav>
          <nav class="crumbs crumbs-kota-banten" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-pulau">Jawa</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-provinsi-banten">Banten</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb on" tabindex="0" for="st-kota-banten">Kota/Kabupaten</label>
          </nav>
          <nav class="crumbs crumbs-provinsi-jawabarat" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-pulau">Jawa</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb on" tabindex="0" for="st-provinsi-jawabarat">Jawa Barat</label>
          </nav>
          <nav class="crumbs crumbs-kota-jawabarat" aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
            <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-pulau">Jawa</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb" tabindex="0" for="st-provinsi-jawabarat">Jawa Barat</label>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
            <label class="pr-crumb on" tabindex="0" for="st-kota-jawabarat">Kota/Kabupaten</label>
          </nav>
          {cityRegions.map((city) => (
            <nav class={`crumbs crumbs-kota crumbs-kota-${city.slug}`} aria-label="Lokasi" style="flex-wrap:wrap;align-items:center;gap:2px">
              <label class="pr-crumb" tabindex="0" for="st-nasional">Indonesia</label>
              <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
              <label class="pr-crumb" tabindex="0" for="st-pulau">Jawa</label>
              <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
              <label class="pr-crumb" tabindex="0" for="st-provinsi">DKI Jakarta</label>
              <span aria-hidden="true" style="display:inline-flex;align-items:center;line-height:1;color:var(--line-strong);padding:0 4px">›</span>
              <label class="pr-crumb on" tabindex="0" for={`st-kota-${city.slug}`}>{city.label}</label>
            </nav>
          ))}

          <div class="pr-map-row" style="display:flex;flex-wrap:wrap;align-items:flex-start;gap:20px">
            <div class="pr-map-col">
              <div class="pr-map-frame">
                <div class="pr-world">
                  {nationalRegions.filter((region) => region.label !== "Jawa").map((region) => (
                    <div class="pr-shape pr-shape-static" aria-hidden="true" style={`clip-path:${region.clip};background:var(--land)`}></div>
                  ))}

                  <div class="pr-java">
                    {pulauRegions.filter((region) => region.target !== "st-provinsi").map((region) => (
                      <label class="pr-shape pr-prov pr-prov-on" role="button" for={region.target} aria-label={region.label} style={`clip-path:${region.clip};--fill:${region.fill}`}></label>
                    ))}
                    <label class="pr-dki-hit" role="button" for="st-provinsi" aria-label="DKI Jakarta" style="left:19.52%;top:18.05%;width:4.39%;height:11.71%"></label>
                    <div class="pr-city-layer" style="left:19.52%;top:18.05%;width:4.39%;height:11.71%">
                      <div class="pr-city-base" aria-hidden="true" style={`clip-path:${DKI_BASE}`}></div>
                      {cityRegions.map((region) => (
                        <label class={`pr-shape pr-city pr-city-${region.slug}`} role="button" for={`st-kota-${region.slug}`} aria-label={region.label} style={`clip-path:${region.clip};--t:${region.t}%`}></label>
                      ))}
                    </div>
                    <label class="pr-banten-hit" role="button" for="st-provinsi-banten" aria-label="Banten" style="left:5.71%;top:16.67%;width:13.81%;height:35.71%"></label>
                    <div class="pr-banten-city-layer" style="left:5.71%;top:16.67%;width:13.81%;height:35.71%">
                      <div class="pr-city-base" aria-hidden="true" style={`clip-path:${BANTEN_BASE}`}></div>
                      {bantenCityRegions.map((region) => (
                        <label class={`pr-shape pr-city pr-city-banten-${region.slug}`} role="button" for="st-kota-banten" aria-label={region.label} style={`clip-path:${region.clip};--t:${region.t}%`}></label>
                      ))}
                    </div>
                    <label class="pr-jawabarat-hit" role="button" for="st-provinsi-jawabarat" aria-label="Jawa Barat" style="left:17.14%;top:19.00%;width:23.81%;height:42.90%"></label>
                    <div class="pr-jawabarat-city-layer" style="left:17.14%;top:19.00%;width:23.81%;height:42.90%">
                      <div class="pr-city-base" aria-hidden="true" style={`clip-path:${JAWABARAT_BASE}`}></div>
                      {jawabaratCityRegions.map((region) => (
                        <label class={`pr-shape pr-city pr-city-jawabarat-${region.slug}`} role="button" for="st-kota-jawabarat" aria-label={region.label} style={`clip-path:${region.clip};--t:${region.t}%`}></label>
                      ))}
                    </div>
                  </div>

                  <label class="pr-java-hit" tabindex="0" role="button" for="st-pulau" aria-label="Jawa" style={`clip-path:${javaIsland.clip}`}></label>

                </div>

                {nationalRegions.map((region) => (
                  <span class="pr-map-label lab-nat" aria-hidden="true" style={`left:${region.lx};top:${region.ly}`}><span>{region.label}</span></span>
                ))}
                {pulauRegions.map((region) => {
                  const x = worldCoord(JAVA_BOX, region.lx, "x");
                  const y = worldCoord(JAVA_BOX, region.ly, "y");
                  return (
                    <span class="pr-map-label lab-prov" aria-hidden="true" style={`left:${project(x, CAMS.pulau, "x")}%;top:${project(y, CAMS.pulau, "y")}%`}><span>{region.label}</span></span>
                  );
                })}
                {cityRegions.map((region) => {
                  const x = worldCoord(CITY_BOX, region.lx, "x");
                  const y = worldCoord(CITY_BOX, region.ly, "y");
                  return (
                    <span class={`pr-map-label lab-kota lab-kota-${region.slug}`} aria-hidden="true" style={`left:${project(x, CAMS.provinsi, "x")}%;top:${project(y, CAMS.provinsi, "y")}%`}><span>{region.label}</span></span>
                  );
                })}
                {bantenCityRegions.map((region) => {
                  const x = worldCoord(BANTEN_BOX, region.lx, "x");
                  const y = worldCoord(BANTEN_BOX, region.ly, "y");
                  return (
                    <span class={`pr-map-label lab-banten lab-banten-${region.slug}`} aria-hidden="true" style={`left:${project(x, CAMS.banten, "x")}%;top:${project(y, CAMS.banten, "y")}%`}><span>{region.label}</span></span>
                  );
                })}
                {jawabaratCityRegions.map((region) => {
                  const x = worldCoord(JAWABARAT_BOX, region.lx, "x");
                  const y = worldCoord(JAWABARAT_BOX, region.ly, "y");
                  return (
                    <span class={`pr-map-label lab-jawabarat lab-jawabarat-${region.slug}`} aria-hidden="true" style={`left:${project(x, CAMS.jawabarat, "x")}%;top:${project(y, CAMS.jawabarat, "y")}%`}><span>{region.label}</span></span>
                  );
                })}

                <label class="zoom-out zoom-pulau" tabindex="0" role="button" for="st-nasional" aria-label="Perkecil peta">
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5M8 11h6"></path></svg>
                </label>
                <label class="zoom-out zoom-provinsi" tabindex="0" role="button" for="st-pulau" aria-label="Perkecil peta">
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5M8 11h6"></path></svg>
                </label>
                <label class="zoom-out zoom-kota" tabindex="0" role="button" for="st-provinsi" aria-label="Perkecil peta">
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5M8 11h6"></path></svg>
                </label>
                <label class="zoom-out zoom-kota-banten" tabindex="0" role="button" for="st-provinsi-banten" aria-label="Perkecil peta">
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5M8 11h6"></path></svg>
                </label>
                <label class="zoom-out zoom-kota-jawabarat" tabindex="0" role="button" for="st-provinsi-jawabarat" aria-label="Perkecil peta">
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5M8 11h6"></path></svg>
                </label>

                <div class="pr-legend" style="position:absolute;left:14px;bottom:12px;display:flex;flex-wrap:wrap;gap:14px;font-size:12px;font-weight:500;color:var(--body);z-index:5">
                  <span style="display:inline-flex;align-items:center;gap:6px"><span aria-hidden="true" style="width:12px;height:12px;border-radius:3px;background:var(--accent)"></span>Data tersedia</span>
                  <span style="display:inline-flex;align-items:center;gap:6px"><span aria-hidden="true" style="width:12px;height:12px;border-radius:3px;background:var(--land)"></span>Segera</span>
                </div>
              </div>
              <p style="margin:0;font-size:12px;color:var(--meta)">Peta disederhanakan untuk contoh tampilan. Versi final memakai batas wilayah resmi.</p>
            </div>

            <aside style="flex:1 1 320px;min-width:0;box-sizing:border-box;padding:20px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:16px">
              <div class="pr-panel panel-nasional" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">NEGARA</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">Indonesia</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Pilih pulau di peta atau dari daftar.</p>
                </div>
                <div style="display:flex;flex-direction:column;gap:8px">
                  <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">PULAU</h4>
                  {islands.map((island) => (
                    <label class="pr-row" tabindex="0" for={island.on ? "st-pulau" : "st-nasional"} style="text-decoration:none;cursor:pointer">
                      <span style="font-weight:600">{island.label}</span>
                      <span class={island.on ? "pr-st on" : "pr-st"}>{island.status}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="pr-panel panel-pulau" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PULAU</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">Jawa</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Pilih provinsi di peta atau dari daftar.</p>
                </div>
                <div style="display:flex;flex-direction:column;gap:8px">
                  <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">PROVINSI</h4>
                  {pulauIslands.map((island) => (
                    <label class="pr-row" tabindex="0" for={island.target} style="text-decoration:none;cursor:pointer">
                      <span style="font-weight:600">{island.label}</span>
                      <span class={island.on ? "pr-st on" : "pr-st"}>{island.status}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="pr-panel panel-provinsi" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PROVINSI</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">DKI Jakarta</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Pilih kota untuk melihat pejabat di tingkat kota.</p>
                </div>
                <div style="display:flex;flex-direction:column;gap:8px">
                  <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">PEJABAT WILAYAH INI</h4>
                  {provinsiOfficials.map((official) => (
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;box-sizing:border-box;padding:10px 14px;border:1px solid var(--line);border-radius:10px">
                      <span style="display:flex;flex-direction:column;min-width:0">
                        <span style="font-size:12px;color:var(--meta)">{official.role}</span>
                        <span style="font-weight:600;color:var(--title)">{official.name}</span>
                      </span>
                      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--meta)"><path d="M9 6l6 6-6 6"></path></svg>
                    </div>
                  ))}
                </div>
                <div style="display:flex;flex-direction:column;gap:8px">
                  <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">KOTA &amp; KABUPATEN</h4>
                  {cityRegions.map((city) => (
                    <label class="pr-row" tabindex="0" for={`st-kota-${city.slug}`} style="text-decoration:none;cursor:pointer">
                      <span style="font-weight:600">{city.label}</span>
                      <span class="pr-st on">Tersedia</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="pr-panel panel-provinsi-banten" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PROVINSI</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">Banten</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Pilih kota atau kabupaten untuk melihat wilayah.</p>
                </div>
                <div style="display:flex;flex-direction:column;gap:8px">
                  <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">KOTA &amp; KABUPATEN</h4>
                  {bantenCityRegions.map((city) => (
                    <label class="pr-row" tabindex="0" for="st-kota-banten" style="text-decoration:none;cursor:pointer">
                      <span style="font-weight:600">{city.label}</span>
                      <span class="pr-st on">Segera</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="pr-panel panel-kota-banten" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PROVINSI</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">Banten</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Data pejabat wilayah Banten sedang disiapkan.</p>
                </div>
              </div>

              <div class="pr-panel panel-provinsi-jawabarat" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PROVINSI</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">Jawa Barat</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Pilih kota atau kabupaten untuk melihat wilayah.</p>
                </div>
                <div style="display:flex;flex-direction:column;gap:8px">
                  <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">KOTA &amp; KABUPATEN</h4>
                  {jawabaratCityRegions.map((city) => (
                    <label class="pr-row" tabindex="0" for="st-kota-jawabarat" style="text-decoration:none;cursor:pointer">
                      <span style="font-weight:600">{city.label}</span>
                      <span class="pr-st on">Segera</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="pr-panel panel-kota-jawabarat" style="flex-direction:column;gap:16px">
                <div style="display:flex;flex-direction:column;gap:2px">
                  <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PROVINSI</p>
                  <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">Jawa Barat</h3>
                  <p style="margin:0;font-size:14px;color:var(--body)">Data pejabat wilayah Jawa Barat sedang disiapkan.</p>
                </div>
              </div>

              {cityRegions.map((city) => {
                const data = cityData[city.slug];
                return (
                  <div class={`pr-panel panel-kota-${city.slug}`} style="flex-direction:column;gap:16px">
                    <div style="display:flex;flex-direction:column;gap:2px">
                      <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">{data.kind}</p>
                      <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">{city.label}</h3>
                      <p style="margin:0;font-size:14px;color:var(--body)">Persempit ke kecamatan atau kelurahan, atau buka profil pejabat.</p>
                    </div>
                    {data.kecs.length > 0 && (
                      <div style="display:flex;flex-wrap:wrap;gap:10px">
                        <div style="flex:1 1 130px;display:flex;flex-direction:column;gap:4px">
                          <label for="kec" style="font-size:12px;font-weight:500;color:var(--meta)">Kecamatan</label>
                          <select id="kec" style="font:inherit;font-size:14px;height:44px;padding:0 10px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--title)">
                            <option>Semua kecamatan</option>
                            {data.kecs.map((kec) => <option>{kec}</option>)}
                          </select>
                        </div>
                        <div style="flex:1 1 130px;display:flex;flex-direction:column;gap:4px">
                          <label for="kel" style="font-size:12px;font-weight:500;color:var(--meta)">Kelurahan</label>
                          <select id="kel" style="font:inherit;font-size:14px;height:44px;padding:0 10px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--title)">
                            <option>Semua kelurahan</option>
                          </select>
                        </div>
                      </div>
                    )}
                    <div style="display:flex;flex-direction:column;gap:8px">
                      <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">PEJABAT WILAYAH INI</h4>
                      {data.officials.map((official) => (
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;box-sizing:border-box;padding:10px 14px;border:1px solid var(--line);border-radius:10px">
                          <span style="display:flex;flex-direction:column;min-width:0">
                            <span style="font-size:12px;color:var(--meta)">{official.role}</span>
                            <span style="font-weight:600;color:var(--title)">{official.name}</span>
                          </span>
                          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--meta)"><path d="M9 6l6 6-6 6"></path></svg>
                        </div>
                      ))}
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px">
                      <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">KOTA &amp; KABUPATEN</h4>
                      {cityRegions.map((item) => (
                        <label class="pr-row" tabindex="0" for={`st-kota-${item.slug}`} style="text-decoration:none;cursor:pointer">
                          <span style="font-weight:600">{item.label}</span>
                          <span class={item.slug === city.slug ? "pr-st on" : "pr-st on"}>{item.slug === city.slug ? "Dipilih" : "Tersedia"}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                );
              })}
            </aside>
          </div>
        </div>
      </section>

      <section id="isu" style="flex-direction:column;gap:16px">
        <h2 style="margin:0;font-size:13px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">ISU HANGAT</h2>
        <div style="display:flex;flex-wrap:wrap;gap:16px">
          <article style="flex:1 1 320px;box-sizing:border-box;padding:24px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
              <div style="display:flex;flex-direction:column;gap:4px">
                <h3 style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:var(--title)">Polemik Kenaikan Tarif Air Bersih</h3>
                <p style="margin:0;font-size:14px;color:var(--body)">Perdebatan Komisi B DPRD &amp; Pemprov DKI</p>
              </div>
              <span style="flex:none;font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;background:var(--neutral-bg);color:var(--neutral-fg)">Dalam Perdebatan</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;font-size:13px;font-weight:500">
              <div style="display:flex;align-items:center;gap:10px">
                <div role="img" aria-label="3 pejabat menolak" style="display:flex">
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box;margin-left:-8px"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box;margin-left:-8px"></span>
                </div>
                <span style="color:var(--against)">3 Menolak</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px">
                <div role="img" aria-label="2 pejabat mendukung" style="display:flex">
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px dashed var(--support);box-sizing:border-box"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px dashed var(--support);box-sizing:border-box;margin-left:-8px"></span>
                </div>
                <span style="color:var(--support)">2 Mendukung</span>
              </div>
            </div>
          </article>

          <article id="janji" style="flex:1 1 320px;box-sizing:border-box;padding:24px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;flex-direction:column;gap:4px">
              <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.08em;color:var(--meta)">SOROTAN JANJI</p>
              <h3 style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:var(--title)">Normalisasi Kali &amp; Relokasi Hunian</h3>
              <p style="margin:0;font-size:14px;color:var(--body)">Gubernur DKI Jakarta</p>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div role="img" aria-label="45 persen terealisasi" style="height:8px;border-radius:999px;background:var(--track);overflow:hidden">
                <div style="width:45%;height:100%;border-radius:999px;background:var(--accent)"></div>
              </div>
              <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:13px">
                <span style="font-weight:600;color:var(--title)">45% Terealisasi</span>
                <span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--meta)">Target: Akhir 2026</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section style="flex-direction:column;gap:16px">
        <h2 style="margin:0;font-size:13px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">RADAR JEJAK TERBARU</h2>
        <div role="group" aria-label="Saring jenis catatan" style="display:flex;flex-wrap:wrap;gap:8px">
          <button type="button" class="pr-tab on" aria-pressed="true">Semua</button>
          <button type="button" class="pr-tab" aria-pressed="false">Janji &amp; Realisasi</button>
          <button type="button" class="pr-tab" aria-pressed="false">Pernyataan</button>
          <button type="button" class="pr-tab" aria-pressed="false">Blunder &amp; Inkonsistensi</button>
        </div>

        <div style="display:flex;flex-direction:column;gap:12px">
          {snapshot.recentRecords.slice(0, 4).map((record: any) => {
            const person = snapshot.personById.get(record.person);
            return (
              <article class="pr-item" style="padding:20px;background:var(--card);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;font-size:13px;color:var(--meta)">
                  <span style="font-weight:500;color:var(--body);border:1px solid var(--line);border-radius:6px;padding:2px 8px">{person?.full_name || "Pejabat"}</span>
                  <span aria-hidden="true">•</span>
                  <span>{formatDate(record.occurred_at, record.occurred_at_precision)}</span>
                  {record.blunder_category && <span style="margin-left:auto;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;background:var(--rose-bg);color:var(--rose-fg);border:1px solid var(--rose-line)">Inkonsistensi</span>}
                </div>
                <h3 style="margin:0;font-size:16px;font-weight:600;color:var(--title)">{record.title}</h3>
                <p style="margin:0;max-width:720px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{record.summary || record.context}</p>
                <a href={`/catatan/${record.slug}`} style="align-self:flex-start;display:inline-flex;align-items:center;gap:6px;padding:6px 10px;margin-top:2px;border-radius:6px;background:var(--chip);border:1px solid var(--line);font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--body)">
                  <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
                  Lihat catatan
                </a>
              </article>
            );
          })}
          {snapshot.recentRecords.length === 0 && <p style="margin:0;padding:28px 20px;border:1px dashed var(--line-strong);border-radius:12px;text-align:center;color:var(--meta)">Belum ada pernyataan terverifikasi minggu ini.</p>}
        </div>
      </section>
    </main>

    <footer style="border-top:1px solid var(--line)">
      <div style="max-width:1120px;margin:0 auto;padding:24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;font-size:13px;color:var(--meta)">
        <span>Independen — bukan situs pemerintah. {updated}</span>
        <div style="display:flex;gap:20px"><a href="/metode">Metode</a><a href="/tentang">Tentang</a><a href="/koreksi">Koreksi</a></div>
      </div>
    </footer>
  </div>
</HomeLayout>
