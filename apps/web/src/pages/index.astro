              <div style="display:flex;flex-direction:column;gap:4px">
                <h3 style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:var(--title)">Polemik Kenaikan Tarif Air Bersih</h3>
                <p style="margin:0;font-size:14px;color:var(--body)">Perdebatan Komisi B DPRD &amp; Pemprov DKI</p>
              </div>
              <span style="flex:none;font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;background:var(--neutral-bg);color:var(--neutral-fg)">Dalam Perdebatan</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;font-size:13px;font-weight:500">
              <div style="display:flex;align-items:center;gap:10px">
                <div role="img" aria-label="3 pejabat menolak" style="display:flex">
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box;margin-left:-8px"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box;margin-left:-8px"></span>
                </div>
                <span style="color:var(--against)">3 Menolak</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px">
                <div role="img" aria-label="2 pejabat mendukung" style="display:flex">
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px dashed var(--support);box-sizing:border-box"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px dashed var(--support);box-sizing:border-box;margin-left:-8px"></span>
                </div>
                <span style="color:var(--support)">2 Mendukung</span>
              </div>
            </div>
          </article>

          <article id="janji" style="flex:1 1 320px;box-sizing:border-box;padding:24px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;flex-direction:column;gap:4px">
              <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.08em;color:var(--meta)">SOROTAN JANJI</p>
              <h3 style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:var(--title)">Normalisasi Kali &amp; Relokasi Hunian</h3>
              <p style="margin:0;font-size:14px;color:var(--body)">Gubernur DKI Jakarta</p>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div role="img" aria-label="45 persen terealisasi" style="height:8px;border-radius:999px;background:var(--track);overflow:hidden">
                <div style="width:45%;height:100%;border-radius:999px;background:var(--accent)"></div>
              </div>
              <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:13px">
                <span style="font-weight:600;color:var(--title)">45% Terealisasi</span>
                <span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--meta)">Target: Akhir 2026</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section style="flex-direction:column;gap:16px">
        <h2 style="margin:0;font-size:13px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">RADAR JEJAK TERBARU</h2>
        <div role="group" aria-label="Saring jenis catatan" style="display:flex;flex-wrap:wrap;gap:8px">
          <button type="button" class="pr-tab on" aria-pressed="true">Semua</button>
          <button type="button" class="pr-tab" aria-pressed="false">Janji &amp; Realisasi</button>
          <button type="button" class="pr-tab" aria-pressed="false">Pernyataan</button>
          <button type="button" class="pr-tab" aria-pressed="false">Blunder &amp; Inkonsistensi</button>
        </div>

        <div style="display:flex;flex-direction:column;gap:12px">
          {snapshot.recentRecords.slice(0, 4).map((record: any) => {
            const person = snapshot.personById.get(record.person);
            return (
              <article class="pr-item" style="padding:20px;background:var(--card);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;font-size:13px;color:var(--meta)">
                  <span style="font-weight:500;color:var(--body);border:1px solid var(--line);border-radius:6px;padding:2px 8px">{person?.full_name || "Pejabat"}</span>
                  <span aria-hidden="true">•</span>
                  <span>{formatDate(record.occurred_at, record.occurred_at_precision)}</span>
                  {record.blunder_category && <span style="margin-left:auto;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;background:var(--rose-bg);color:var(--rose-fg);border:1px solid var(--rose-line)">Inkonsistensi</span>}
                </div>
                <h3 style="margin:0;font-size:16px;font-weight:600;color:var(--title)">{record.title}</h3>
                <p style="margin:0;max-width:720px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{record.summary || record.context}</p>
                <a href={`/catatan/${record.slug}`} style="align-self:flex-start;display:inline-flex;align-items:center;gap:6px;padding:6px 10px;margin-top:2px;border-radius:6px;background:var(--chip);border:1px solid var(--line);font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--body)">
                  <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
                  Lihat catatan
                </a>
              </article>
            );
          })}
          {snapshot.recentRecords.length === 0 && <p style="margin:0;padding:28px 20px;border:1px dashed var(--line-strong);border-radius:12px;text-align:center;color:var(--meta)">Belum ada pernyataan terverifikasi minggu ini.</p>}
        </div>
      </section>
    </main>

    <footer style="border-top:1px solid var(--line)">
      <div style="max-width:1120px;margin:0 auto;padding:24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;font-size:13px;color:var(--meta)">
        <span>Independen — bukan situs pemerintah. {updated}</span>
        <div style="display:flex;gap:20px"><a href="/metode">Metode</a><a href="/tentang">Tentang</a><a href="/koreksi">Koreksi</a></div>
      </div>
    </footer>
  </div>
</HomeLayout>
