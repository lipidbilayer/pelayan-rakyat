const javaIsland = nationalRegions.find((region) => region.label === "Jawa")!;

const JAVA_BOX = { left: 23.02, top: 65, width: 20, height: 20 };
// DKI occupies the coastal slot between Banten and Jawa Barat. The slot is the
// real Jakarta bounding box: 4.39 x 11.71 of the Java box keeps the silhouette
// at its true 1:1.01 aspect, with sea left above it for Kepulauan Seribu.
const CITY_BOX = { left: 26.924, top: 68.61, width: 0.878, height: 2.342 };
const worldCoord = (box: { left: number; top: number; width: number; height: number }, value: string, axis: "x" | "y") =>
  (axis === "x" ? box.left : box.top) + (parseFloat(value) * (axis === "x" ? box.width : box.height)) / 100;
// Same cameras as home.css. Labels sit outside the scaled world, so their frame
// positions are projected here at build time to keep the text sharp.
const CAMS = {
  pulau: { scale: 5, tx: -115.1, ty: -325 },
  provinsi: { scale: 42.699, tx: -1118.37, ty: -2929.55 },
};

// Simplified ADM1 outline of DKI Jakarta (geoBoundaries, ODbL), projected into
// the slot with the land occupying y 8.2%-100%. The pale base closes the seams
// between the kota shapes and keeps the province silhouette recognisable.
const DKI_BASE = "polygon(0% 8.2%,100% 8.2%,100% 100%,0% 100%)";
const project = (value: number, cam: { scale: number; tx: number; ty: number }, axis: "x" | "y") =>
  value * cam.scale + (axis === "x" ? cam.tx : cam.ty);

