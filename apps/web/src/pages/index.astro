---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadSnapshot, formatDate } from "../data/api";

const snapshot = await loadSnapshot();
const active = (p: any) => p.status === "active";
const governorCount = snapshot.positions.filter((p: any) => active(p) && snapshot.institutionById.get(p.institution)?.kind === "governor_office").length;
const dprdCount = snapshot.positions.filter((p: any) => active(p) && snapshot.institutionById.get(p.institution)?.kind === "dprd_dki" && p.title === "Anggota").length;
const cityCount = snapshot.positions.filter((p: any) => active(p) && (p.title === "Wali Kota" || p.title === "Bupati")).length;
const updated = new Date().toLocaleDateString("id-ID", { timeZone: "Asia/Jakarta", day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title="Pelayan Rakyat" description="Catatan publik tentang ucapan, janji, dan kinerja pejabat di Indonesia. Independen, bersumber, dan tanpa glorifikasi.">
  <style>
    .pr, .pr * { box-sizing: border-box; }
    .pr-navlinks { display: flex; }
    @media (max-width: 720px) { .pr-navlinks { display: none !important; } .pr-kbd { display: none !important; } }
  </style>
  <div class="pr" style="--bg:#fcfcfd;--card:#ffffff;--line:#e2e8f0;--line-strong:#cbd5e1;--title:#0f172a;--body:#475569;--meta:#64748b;--chip:#f8fafc;--ink:#0f172a;--ink-on:#ffffff;--track:#eef2f6;--amber-bg:#fffbeb;--amber-fg:#92400e;--amber-line:#fde68a;--rose-bg:#f5f3ff;--rose-fg:#5b21b6;--rose-line:#ddd6fe;--accent:#c8102e;--accent-on:#ffffff;--accent-text:#b91c1c;--neutral-bg:#f1f5f9;--neutral-fg:#334155;--against:#c2410c;--support:#1d4ed8;--sea:#f1f5f9;--land:#cbd5e1;--hero:#c8102e;--motif:rgba(255,255,255,0.17);min-height:100vh;background:var(--bg);color:var(--body);font-family:Geist,Inter,system-ui,sans-serif;font-size:15px;line-height:1.5;overflow-x:hidden">

    <div style="min-height:min(100vh,860px);display:flex;flex-direction:column">
      <div class="pr-hero" style="flex:3 1 auto;display:flex;flex-direction:column;color:#ffffff;background-color:var(--hero);background-image:radial-gradient(ellipse 46% 52% at 50% 58%,var(--hero) 0,var(--hero) 55%,transparent 100%),radial-gradient(circle at 0 0,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 100% 0,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 0 100%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 100% 100%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 50% 50%,transparent 23px,var(--motif) 23px,var(--motif) 24px,transparent 24px),radial-gradient(circle at 50% 50%,var(--motif) 0,var(--motif) 3px,transparent 3px);background-size:100% 100%,48px 48px,48px 48px,48px 48px,48px 48px,48px 48px,48px 48px">
        <header>
          <div style="max-width:1120px;margin:0 auto;padding:14px 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px">
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px">
              <a href="/" style="font-weight:700;font-size:15px;letter-spacing:0.08em;color:#ffffff;display:inline-flex;align-items:center;gap:10px">
                <span aria-hidden="true" style="display:flex;flex-direction:column;width:20px;height:14px;border:1px solid rgba(255,255,255,0.8);border-radius:3px;overflow:hidden;box-sizing:border-box"><span style="flex:1;background:var(--accent)"></span><span style="flex:1;background:#ffffff"></span></span>
                PELAYAN RAKYAT
              </a>
              <span style="font-size:11px;font-weight:500;color:#ffffff;border:1px solid rgba(255,255,255,0.55);border-radius:999px;padding:3px 10px">Independen — Bukan Situs Pemerintah</span>
            </div>
            <nav style="display:flex;align-items:center;gap:8px">
              <div class="pr-navlinks" style="display:flex;align-items:center;gap:4px;font-size:14px;font-weight:500">
                <a href="#peta" style="padding:12px 12px;color:#ffffff">Peta</a>
                <a href="#isu" style="padding:12px 12px;color:#ffffff">Isu Hangat</a>
                <a href="/janji" style="padding:12px 12px;color:#ffffff">Janji</a>
                <a href="/kirim" style="padding:12px 12px;color:#ffffff">Kirim Laporan</a>
              </div>
              <a href="/kirim" style="display:inline-flex;align-items:center;gap:6px;min-height:44px;box-sizing:border-box;padding:0 16px;border:1px solid #ffffff;background:#ffffff;border-radius:10px;font-size:14px;font-weight:600;color:var(--hero)">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                Laporkan Jejak
              </a>
            </nav>
          </div>
        </header>
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:20px;padding:40px 24px 96px">
          <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.14em;color:rgba(255,255,255,0.9)">PLATFORM AKUNTABILITAS PUBLIK</p>
          <h1 style="margin:0;max-width:920px;font-size:clamp(36px,5.6vw,64px);line-height:1.05;font-weight:700;letter-spacing:-0.03em;color:#ffffff;text-wrap:balance">Pantau Janji dan Rekam Jejak Pejabat Publik.</h1>
          <p style="margin:0;max-width:600px;font-size:19px;color:rgba(255,255,255,0.94)">Basis data independen berbasis bukti primer. Kita gaji, kita nilai.</p>
        </div>
      </div>

      <section style="flex:2 1 auto;display:flex;flex-direction:column;align-items:stretch;text-align:center;gap:24px;padding:0 24px 24px">
        <form role="search" action="/cari" method="get" style="width:100%;max-width:760px;margin-top:-36px;display:flex;align-items:center;gap:12px;box-sizing:border-box;padding:0 12px 0 22px;height:72px;background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 10px 30px rgba(15,23,42,0.12)">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex:none;color:var(--meta)"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <label for="q" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Cari pejabat, kebijakan, atau isu</label>
          <input id="q" name="q" type="search" placeholder="Cari nama pejabat, kebijakan, atau isu hangat..." style="flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;font:inherit;font-size:16px;color:var(--title)">
          <button type="submit" style="flex:none;height:48px;padding:0 22px;border:0;border-radius:12px;background:var(--accent);color:var(--accent-on);font:inherit;font-size:15px;font-weight:600;cursor:pointer">Cari</button>
        </form>

        <div style="width:100%;text-align:center;font-size:13px">
          <span style="color:var(--meta);margin-right:4px">Isu Populer:</span>
          <a href="/cari?q=Kenaikan+Tarif+Air" style="display:inline-block;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500;margin:4px">#KenaikanTarifAir</a>
          <a href="/cari?q=Banjir+DKI" style="display:inline-block;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500;margin:4px">#BanjirDKI</a>
          <a href="/cari?q=Janji+Transportasi" style="display:inline-block;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500;margin:4px">#JanjiTransportasi</a>
          <a href="/cari?q=DPRD+DKI" style="display:inline-block;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-weight:500;margin:4px">#DPRDDKI</a>
        </div>
        <a href="#peta" style="margin-top:auto;display:inline-flex;align-items:center;gap:6px;min-height:44px;font-size:13px;font-weight:500;color:var(--meta)">Atau pilih wilayah di peta
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
        </a>
      </section>
    </div>

    <main style="max-width:1120px;margin:0 auto;padding:48px 24px 80px;display:flex;flex-direction:column;gap:72px">

      <section id="peta" style="display:flex;flex-direction:column;gap:20px">
        <div style="display:flex;flex-direction:column;gap:8px">
          <h2 style="margin:0;font-size:clamp(26px,3.2vw,36px);line-height:1.1;font-weight:700;letter-spacing:-0.03em;color:var(--title)">Siapa yang melayani wilayah Anda?</h2>
          <p style="margin:0;max-width:620px;font-size:17px;color:var(--meta)">Pilih pulau, lalu provinsi, lalu kota. Daftar pejabat wilayah itu muncul di samping peta.</p>
        </div>

        <div style="display:flex;flex-wrap:wrap;align-items:flex-start;gap:20px">
          <aside style="flex:1 1 320px;min-width:0;box-sizing:border-box;padding:20px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:16px">
            <div style="display:flex;flex-direction:column;gap:2px">
              <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--accent-text)">PROVINSI</p>
              <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--title)">DKI Jakarta</h3>
              <p style="margin:0;font-size:14px;color:var(--meta)">Pilih kota untuk melihat pejabat di tingkat kota.</p>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">KOTA &amp; KABUPATEN</h4>
              <a href="/pemprov" style="font:inherit;width:100%;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--title);cursor:pointer;text-decoration:none"><span style="font-weight:600">Jakarta Pusat</span><span style="font-size:12px;font-weight:600;color:var(--accent-text)">Tersedia</span></a>
              <a href="/pemprov" style="font:inherit;width:100%;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--title);cursor:pointer;text-decoration:none"><span style="font-weight:600">Jakarta Selatan</span><span style="font-size:12px;font-weight:600;color:var(--accent-text)">Tersedia</span></a>
              <a href="/pemprov" style="font:inherit;width:100%;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--title);cursor:pointer;text-decoration:none"><span style="font-weight:600">Jakarta Barat</span><span style="font-size:12px;font-weight:600;color:var(--accent-text)">Tersedia</span></a>
              <a href="/pemprov" style="font:inherit;width:100%;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--title);cursor:pointer;text-decoration:none"><span style="font-weight:600">Jakarta Timur</span><span style="font-size:12px;font-weight:600;color:var(--accent-text)">Tersedia</span></a>
              <a href="/pemprov" style="font:inherit;width:100%;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--title);cursor:pointer;text-decoration:none"><span style="font-weight:600">Jakarta Utara</span><span style="font-size:12px;font-weight:600;color:var(--accent-text)">Tersedia</span></a>
              <a href="/pemprov" style="font:inherit;width:100%;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:10px;color:var(--title);cursor:pointer;text-decoration:none"><span style="font-weight:600">Kepulauan Seribu</span><span style="font-size:12px;font-weight:600;color:var(--meta)">Segera</span></a>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <h4 style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">PEJABAT WILAYAH INI</h4>
              <a href="/pemprov" style="display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;box-sizing:border-box;padding:10px 14px;border:1px solid var(--line);border-radius:10px">
                <span style="display:flex;flex-direction:column;min-width:0"><span style="font-size:12px;color:var(--meta)">Gubernur DKI Jakarta</span><span style="font-weight:600;color:var(--title)">Anies Baswedan</span></span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--meta)"><path d="M9 6l6 6-6 6"></path></svg>
              </a>
            </div>
          </aside>
        </div>
      </section>

      <section id="isu" style="display:flex;flex-direction:column;gap:16px">
        <h2 style="margin:0;font-size:13px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">ISU HANGAT</h2>
        <div style="display:flex;flex-wrap:wrap;gap:16px">
          <article style="flex:1 1 320px;box-sizing:border-box;padding:24px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
              <div style="display:flex;flex-direction:column;gap:4px">
                <h3 style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:var(--title)">Polemik Kenaikan Tarif Air Bersih</h3>
                <p style="margin:0;font-size:14px;color:var(--meta)">Perdebatan Komisi B DPRD &amp; Pemprov DKI</p>
              </div>
              <span style="flex:none;font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;background:var(--neutral-bg);color:var(--neutral-fg)">Dalam Perdebatan</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;font-size:13px;font-weight:500">
              <div style="display:flex;align-items:center;gap:10px">
                <div role="img" aria-label="3 pejabat menolak" style="display:flex">
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box;margin-left:-8px"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px solid var(--against);box-sizing:border-box;margin-left:-8px"></span>
                </div>
                <span style="color:var(--against)">3 Menolak</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px">
                <div role="img" aria-label="2 pejabat mendukung" style="display:flex">
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px dashed var(--support);box-sizing:border-box"></span>
                  <span style="width:28px;height:28px;border-radius:50%;background:var(--chip);border:2px dashed var(--support);box-sizing:border-box;margin-left:-8px"></span>
                </div>
                <span style="color:var(--support)">2 Mendukung</span>
              </div>
            </div>
          </article>

          <article id="janji" style="flex:1 1 320px;box-sizing:border-box;padding:24px;background:var(--card);border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:20px">
            <div style="display:flex;flex-direction:column;gap:4px">
              <p style="margin:0;font-size:12px;font-weight:600;letter-spacing:0.08em;color:var(--meta)">SOROTAN JANJI</p>
              <h3 style="margin:0;font-size:18px;font-weight:600;letter-spacing:-0.01em;color:var(--title)">Normalisasi Kali &amp; Relokasi Hunian</h3>
              <p style="margin:0;font-size:14px;color:var(--meta)">Gubernur DKI Jakarta</p>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div role="img" aria-label="45 persen terealisasi" style="height:8px;border-radius:999px;background:var(--track);overflow:hidden">
                <div style="width:45%;height:100%;border-radius:999px;background:var(--accent)"></div>
              </div>
              <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-size:13px">
                <span style="font-weight:600;color:var(--title)">45% Terealisasi</span>
                <span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--meta)">Target: Akhir 2026</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section style="display:flex;flex-direction:column;gap:16px">
        <h2 style="margin:0;font-size:13px;font-weight:600;letter-spacing:0.1em;color:var(--meta)">RADAR JEJAK TERBARU</h2>
        <div style="display:flex;flex-direction:column;gap:12px">
          {snapshot.recentRecords.slice(0, 4).map((record: any) => {
            const person = snapshot.personById.get(record.person);
            return (
              <article class="pr-item" style="padding:20px;background:var(--card);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;font-size:13px;color:var(--meta)">
                  <span style="font-weight:500;color:var(--body);border:1px solid var(--line);border-radius:6px;padding:2px 8px">{person?.full_name || "Pejabat"}</span>
                  <span aria-hidden="true">•</span>
                  <span>{formatDate(record.occurred_at, record.occurred_at_precision)}</span>
                  {record.blunder_category && <span style="margin-left:auto;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;background:var(--rose-bg);color:var(--rose-fg);border:1px solid var(--rose-line)">Inkonsistensi</span>}
                </div>
                <h3 style="margin:0;font-size:16px;font-weight:600;color:var(--title)">{record.title}</h3>
                <p style="margin:0;max-width:720px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{record.summary || record.context}</p>
                <a href={`/catatan/${record.slug}`} style="align-self:flex-start;display:inline-flex;align-items:center;gap:6px;padding:6px 10px;margin-top:2px;border-radius:6px;background:var(--chip);border:1px solid var(--line);font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:var(--body)">Lihat catatan</a>
              </article>
            );
          })}
          {snapshot.recentRecords.length === 0 && <p style="margin:0;padding:28px 20px;border:1px dashed var(--line-strong);border-radius:12px;text-align:center;color:var(--meta)">Belum ada pernyataan terverifikasi minggu ini.</p>}
        </div>
      </section>

    </main>

    <footer style="border-top:1px solid var(--line)">
      <div style="max-width:1120px;margin:0 auto;padding:24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;font-size:13px;color:var(--meta)">
        <span>Independen — bukan situs pemerintah. {updated}</span>
        <div style="display:flex;gap:20px"><a href="/metode">Metode</a><a href="/tentang">Tentang</a><a href="/koreksi">Koreksi</a></div>
      </div>
    </footer>

  </div>
</BaseLayout>
