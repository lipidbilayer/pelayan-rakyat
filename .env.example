# Pelayan Rakyat - example environment file.
# Copy to .env and fill in real values. Never commit .env.
#
# Local:      cp .env.example .env
# Production: /opt/pelayan-rakyat/.env

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# Caddy listen address.
# Before a domain exists, use HTTP on port 80:
#   SITE_ADDRESS=http://:80
# After DNS points at the server, use the bare domain only. Caddy then
# obtains and renews HTTPS certificates automatically:
#   SITE_ADDRESS=pelayanrakyat.id
SITE_ADDRESS=http://:80

# Canonical public URL, used by Astro for canonical and Open Graph tags.
# Local: http://localhost
# Production (IP only): http://203.0.113.10  (replace with the server IP)
# Production (domain): https://pelayanrakyat.id
SITE_URL=http://localhost

# Where Caddy reads the built static site from.
# Local development uses the Astro dist directory relative to infra/.
# Production uses /srv/site, which the web deploy workflow writes to.
SITE_ROOT=../apps/web/dist

# Loopback address where Caddy serves the PocketBase dashboard. Reach it with an
# SSH tunnel (ssh -L 8081:127.0.0.1:8081 deploy@server) or by binding this to a
# Tailscale address. It is never published on the public interfaces.
ADMIN_LISTEN_ADDRESS=http://127.0.0.1:8081

# ---------------------------------------------------------------------------
# PocketBase
# ---------------------------------------------------------------------------

# Production deploy.sh overrides this with the image tag built by GitHub
# Actions (ghcr.io/<owner>/<repo>/pocketbase:<git-sha>). Leave the local tag
# here for docker compose builds.
PB_IMAGE=pelayan-rakyat/pocketbase:local

# Created once, on first boot only, when /pb_data/data.db does not exist.
# Use a long, unique password. Changing these values later does not change
# the existing account (use the PocketBase CLI or dashboard instead).
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-unique-password

# Optional 32-character key. When set, PocketBase encrypts app settings at rest.
# Losing it means the encrypted settings (including backup credentials) cannot
# be recovered; the database records themselves stay readable.
PB_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Site rebuild trigger (PocketBase -> GitHub Actions)
# ---------------------------------------------------------------------------

# Fine-grained token with permission to trigger workflows on this repository only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/pelayan-rakyat
PB_SITE_DIRTY_FILE=/pb_data/site_dirty

# ---------------------------------------------------------------------------
# Backups (PocketBase built-in scheduled backups -> S3-compatible bucket)
# ---------------------------------------------------------------------------

# Set to true only after every PB_BACKUP_S3_* value below is filled in.
PB_BACKUP_S3_ENABLED=false

# Daily at 02:00 UTC. Keep 14 automatic backups.
PB_BACKUP_CRON=0 2 * * *
PB_BACKUP_KEEP=14

# Cloudflare R2 example:
#   endpoint: https://<account-id>.r2.cloudflarestorage.com
#   region:   auto
#   force path style: true
# Backblaze B2 example:
#   endpoint: https://s3.<region>.backblazeb2.com
#   region:   <region>   (for example us-west-004)
#   force path style: true
PB_BACKUP_S3_BUCKET=
PB_BACKUP_S3_REGION=auto
PB_BACKUP_S3_ENDPOINT=
PB_BACKUP_S3_ACCESS_KEY=
PB_BACKUP_S3_SECRET=
PB_BACKUP_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Server-side deploy (optional)
# ---------------------------------------------------------------------------

# Only needed if the GHCR package is private. With a public repo and public
# package, leave these empty. deploy.sh logs in only when GHCR_TOKEN is set.
GHCR_USER=
GHCR_TOKEN=
